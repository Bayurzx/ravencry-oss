# ============================================================================
# RAVENCRY Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================================

# ── LLM Provider (AGNOSTIC) ────────────────────────────────────────────────
# Swap between providers by changing LLM_PROVIDER.
# No other code changes needed.

# qwen | openai | deepseek | gemini

LLM_PROVIDER=qwen
LLM_API_KEY=REDACTED
DASHSCOPE_API_KEY=REDACTED
LLM_MODEL=
LLM_BASE_URL=
# LLM_SERVICE_URL=http://localhost:3002
LLM_SERVICE_URL=http://host.docker.internal:3002
# Examples:
#   Qwen:     LLM_PROVIDER=qwen     LLM_API_KEY=sk-xxx
#   DeepSeek: LLM_PROVIDER=deepseek LLM_API_KEY=sk-xxx  LLM_BASE_URL=https://api.deepseek.com/v1
#   OpenAI:   LLM_PROVIDER=openai   LLM_API_KEY=sk-xxx
#   Gemini:   LLM_PROVIDER=gemini   LLM_API_KEY=AIza-xxx

# ── QWEN ────────────────────────────────────────────────────────────────
QWEN_LLM_API_KEY=REDACTED
DEEPSEEK_API_KEY=<your-deepseek-api-key>

OPENAI_API_KEY=<your-openai-api-key>

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=<your-database-url>
DB_PASSWORD=REDACTED
DB_HOST=<your-rds-host>
DB_PORT=5432
DB_USER=<your-db-user>
DB_NAME=ravencry
RDS_ENDPOINT=<your-rds-endpoint>
RDS_PORT=5432

# ── Aurora Database ────────────────────────────────────────────────────────────────
AURORA_ENDPOINT=<your-aurora-endpoint>
AURORA_PORT=5432

# ── Local Database ────────────────────────────────────────────────────────────────
LOCAL_PG=<your-local-postgres-url>
# DATABASE_URL="postgres://postgres:test@localhost:5433/ravencry"

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=REDACTED
S3_BUCKET=<your-s3-bucket>

AWS_PROFILE=ravencry
SG_NAME=<your-security-group-name>
INSTANCE_ID=<your-instance-id>
CLUSTER_ID=<your-cluster-id>

# ── EC2 ───────────────────────────────────────────────────────────────────────
# EC2_IP="35.153.54.6"
EC2_IP=<your-server-ip>

# ── Africa's Talking (SMS + USSD only) ────────────────────────────────────────
# NOTE: AT does NOT offer WhatsApp in sandbox. Use Meta Cloud API below.
AT_API_KEY=<your-africastalking-api-key>
AT_USERNAME=sandbox
AT_USSD_CODE=*384*72836
AT_SANDBOX_TEST_PHONES=+2348000000001,+2348000000002

SMS_SERVICE_URL=http://host.docker.internal:3006

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────
# System User token from Meta Business
META_WHATSAPP_TOKEN=REDACTED

# Phone Number ID from WhatsApp API Setup
META_PHONE_NUMBER_ID=<your-phone-number-id>
META_WHATSAPP_BUSINESS_ACCOUNT_ID=<your-business-account-id>
# Your chosen verify token
META_WEBHOOK_VERIFY_TOKEN=<your-verify-token>
META_WHATSAPP_API_VERSION=v25.0

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REDACTED
TELEGRAM_ALERT_CHANNEL_ID=<your-alert-channel-id>
TELEGRAM_OPS_CHANNEL_ID=<your-ops-channel-id>
TELEGRAM_SERVICE_URL=http://host.docker.internal:3005
OPS_TELEGRAM_CHAT_ID=<your-ops-chat-id>

# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=<generate-a-strong-secret>
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crucix-flash
# ============================================================================
# n8n Configuration
# ============================================================================
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost

# ============================================================================
# n8n Tunnel Configuration (Don't use with `n8n Configuration`)
# ============================================================================
# N8N_PORT=5678
# N8N_PROTOCOL=https
# N8N_HOST=<your-n8n-host>
# WEBHOOK_URL=https://<your-n8n-host>/


# ============================================================================
# n8n Other Configuration
# ============================================================================
N8N_SECURE_COOKIE=false
# For self-hosted n8n, set binary data mode to filesystem
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Encryption key for credentials (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
# ============================================================================
# n8n Configuration End
# ============================================================================

# ── Appsmith ────────────────────────────────────────────────────────────────
APPSMITH_ENCRYPTION_PASSWORD=REDACTED
APPSMITH_ENCRYPTION_SALT=<generate-a-random-salt>
APPSMITH_SUPERVISOR_PASSWORD=REDACTED

# ── Whisper ─────────────────────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_SERVICE_URL=http://host.docker.internal:8000

# ── Web Push (VAPID) ───────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=REDACTED
VAPID_PRIVATE_KEY=REDACTED
VAPID_EMAIL=mailto:admin@ravencry.cv

# ── API Gateway ─────────────────────────────────────────────────────────────
API_PORT=3003
NODE_ENV=development
API_GATEWAY_URL=http://host.docker.internal:3003

# ── Ops ─────────────────────────────────────────────────────────────────────
# Set true for demo mode
AUTO_APPROVE_FLASH=true

# ── JWT (Operator Auth) ────────────────────────────────────────────────────
JWT_SECRET=<generate-a-strong-secret>

# ── Phone Encryption ────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM
PHONE_ENCRYPTION_KEY=<generate-a-32-byte-hex-key>

# ── acleddata.com Independent conflict data monitor ────────────────────────────────────────────────────────
ACLED_EMAIL=<your-acled-account-email>
ACLED_PASSWORD=REDACTED

# ── NAPTIP Service ────────────────────────────────────────────────────────
NAPTIP_SERVICE_URL=http://host.docker.internal:3008

# ── Alibaba Cloud / Aliyun (ECS-only deployment) ──────────────────────────────
# ECS on Alibaba Cloud runs Docker Compose. Aurora + S3 stay on AWS.
# See steps_aliyun.md for the full deployment guide.

ALIBABA_CLOUD_REGION=eu-west-1
# ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ALIBABA_ACCESS_KEY
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ALIBABA_SECRET_KEY

# ── Alibaba Cloud ECS (EC2 equivalent) ──────────────────────────────────────
# ECS_IP=47.xx.xx.xx
ECS_PASSWORD=<your-ecs-password>

PROJECT=ravencry
