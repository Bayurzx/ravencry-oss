# =============================================================================
# RAVENCRY Alibaba Cloud — Terraform Variables
# Copy to terraform.tfvars:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# Alibaba Cloud region (already configured in CLI: eu-west-1)
region = "eu-west-1"

# ECS password (fallback; key-based auth preferred)
ecs_password = "YOUR_ECS_PASSWORD_HERE"

# SSH public key (paste the content of ~/.ssh/id_ed25519.pub)
ssh_pubkey = "ssh-ed25519 AAAA... you@host"
