    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- FLASH alerts: 50km radius. PRIORITY: 25km. ROUTINE: 10km.\n-- Returns subscriber_id for SMS lookup, push subscription data for Web Push.\nSELECT\n  s.id AS subscriber_id,\n  s.phone_hash,              -- SHA-256 — for dedup only, NOT for SMS\n  s.state,\n  s.lga,\n  s.whatsapp_opted_in,\n  ST_Distance(s.location, ST_SetSRID(ST_MakePoint({{ $node[\"Fetch Case\"].json.last_seen_lon }}, {{ $node[\"Fetch Case\"].json.last_seen_lat }}), 4326)::geography) / 1000 AS distance_km,\n  ps.endpoint AS push_endpoint,\n  ps.p256dh AS push_p256dh,\n  ps.auth AS push_auth\nFROM subscribers s\nLEFT JOIN push_subscriptions ps ON s.id = ps.subscriber_id\nWHERE\n  s.active = TRUE\n  AND s.location IS NOT NULL\n  AND ST_DWithin(\n    s.location,\n    ST_SetSRID(ST_MakePoint({{ $node[\"Fetch Case\"].json.last_seen_lon }}, {{ $node[\"Fetch Case\"].json.last_seen_lat }}), 4326)::geography,\n    CASE\n      WHEN '{{ $json.alert_tier }}' = 'FLASH' THEN 50000\n      WHEN '{{ $json.alert_tier }}' = 'PRIORITY' THEN 25000\n      ELSE 10000\n    END\n  )\nORDER BY distance_km ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        -112
      ],
      "id": "e8ad638a-db8b-444f-8b58-fb6f32a3b837",
      "name": "Geofence",
