        "query": "SELECT\n  id,\n  similarity(raw_report, '{{ $node[\"Split Events\"].json.events.title }} {{ $node[\"Split Events\"].json.events.location }}') AS sim_score\nFROM cases\nWHERE\n  status IN ('pending_triage', 'pending_review', 'pending_sweep')\n  AND raw_report IS NOT NULL\n  AND similarity(raw_report, '{{ $node[\"Split Events\"].json.events.title }} {{ $node[\"Split Events\"].json.events.location }}') > 0.35\nORDER BY sim_score DESC\nLIMIT 1;",
