# === Port (RAVENCRY docker-compose expects 3001) ===
PORT=3001

# === Sweep interval ===
REFRESH_INTERVAL_MINUTES=5

# === LLM (Qwen via OpenAI-compatible endpoint) ===
LLM_PROVIDER=openai
LLM_API_KEY=REDACTED
LLM_MODEL=qwen-plus

# === Telegram Alerts (RAVENCRY bot) ===
TELEGRAM_BOT_TOKEN=REDACTED
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# === FIRMS — NASA fire/thermal anomaly detection ===
# Register: firms.modaps.eosdis.nasa.gov/api (free)
# Why: Bandit raids in Northwest Nigeria (Zamfara, Kaduna, Katsina, Niger)
# routinely burn villages, granaries, and vehicles. Thermal anomaly clusters
# in these LGAs can signal an attack in progress or within the past 3 hours.
FIRMS_MAP_KEY=<your-firms-api-key>

# === ACLED — Armed Conflict Location & Event Data ===
# Register: acleddata.com/user/register
# Why: Conflict events (Boko Haram, banditry, farmer-herder clashes) in
# Zamfara/Kaduna/Borno are strongly correlated with kidnapping spikes.
ACLED_EMAIL=<your-acled-account-email>
ACLED_PASSWORD=<your-acled-password>

# === RAVENCRY n8n webhook (fires FLASH events to n8n WF-03) ===
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crucix-flash
N8N_WEBHOOK_SECRET=<generate-a-strong-secret>

# === RAVENCRY API (for citizen-reports.mjs Aurora queries) ===
RAVENCRY_API_URL=http://localhost:3003

# === Additional Crucix OSINT Sources (optional — degrade gracefully if unset) ===

# Federal Reserve Economic Data (free: fred.stlouisfed.org/docs/api)
FRED_API_KEY=

# Energy Information Administration (free: api.eia.gov/register)
EIA_API_KEY=

# Maritime AIS data (aisstream.io)
AISSTREAM_API_KEY=

# Cloudflare Radar internet outages & traffic anomalies (free: dash.cloudflare.com/profile/api-tokens, Account Analytics Read)
CLOUDFLARE_API_TOKEN=

# Ollama base URL (only needed if using local Ollama LLM provider)
OLLAMA_BASE_URL=
