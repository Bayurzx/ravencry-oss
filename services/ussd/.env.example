# ============================================================================
# RAVENCRY USSD Service — Environment Variables
# Copy to .env:  cp .env.example .env
#
# If you already have the root ravencry .env, you can symlink instead:
#   mklink .env ..\..\..env   (Windows)
#   ln -s ../../.env .env     (Linux/Mac)
# ============================================================================

# ── Aurora PostgreSQL ─────────────────────────────────────────────────────
# Required. Connection string for Aurora/PostgreSQL.
DATABASE_URL=postgres://ravencry_admin:password@localhost:5432/ravencry

# ── AWS Credentials (for DynamoDB rate limiting) ──────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Service Auth ──────────────────────────────────────────────────────────
# Shared secret for X-Service-Auth header (optional, skipped if unset).
N8N_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3007
NODE_ENV=development

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Max reports per phone number per 24 hours (default: 3)
USSD_MAX_REPORTS_PER_DAY=3
