# ============================================================================
# RAVENCRY SMS Service — Environment Variables
# Copy to .env:  cp .env.example .env
#
# If you already have the root ravencry .env, you can symlink instead:
#   mklink .env ..\..\.env   (Windows)
#   ln -s ../../.env .env     (Linux/Mac)
#
# This service reads BOTH naming conventions:
#   AFRICASTALKING_*  (canonical container name, set by docker-compose)
#   AT_*              (root .env name, works directly with bare Node)
# ============================================================================

# ── Africa's Talking API ──────────────────────────────────────────────────
# Required. Your AT sandbox or production credentials.
# Copy these from your root .env or AT dashboard.
AFRICASTALKING_API_KEY=atsk_...
AFRICASTALKING_USERNAME=sandbox

# ── Sender ID ─────────────────────────────────────────────────────────────
# Alphanumeric sender shown on recipients' phones (max 11 chars).
# SANDBOX: Leave blank — AT ignores custom senders in sandbox and uses "AFRICASTKNG".
# PRODUCTION: Use your approved sender ID (e.g. "RAVENCRY").
# AT_SENDER_ID=RAVENCRY

# ── Service Auth ──────────────────────────────────────────────────────────
# Shared secret for X-Service-Auth header (n8n → SMS calls).
# Must match the value used by n8n WF-02.
# If unset, auth check is skipped (lenient for local dev).
N8N_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=development

# ── Sandbox Test Phones (hackathon) ───────────────────────────────────────
# Comma-separated +234... numbers from AT Sandbox Simulator.
# Used by /sms/broadcast-by-subscribers when AES-256-GCM decryption is unavailable.
# If empty, the endpoint returns mock success without sending real SMS.
AT_SANDBOX_TEST_PHONES=+2348012345678,+2348098765432
